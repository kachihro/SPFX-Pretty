{
  "name": "spfx-pretty",
  "displayName": "SPFX-Pretty",
  "description": "Make SharePoint Framework solutions look great in the App Catalog and toolbox: nice titles, icons for the .sppkg and every component, and theme-aware branding checks.",
  "version": "0.3.1",
  "publisher": "ChrisOC",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Linters", "Other"],
  "keywords": ["SPFx", "SharePoint", "App Catalog", "web part", "branding", "icons"],
  "main": "./out/extension.js",
  "bin": {
    "spfx-pretty": "./out/cli.js"
  },
  "activationEvents": [
    "workspaceContains:**/config/package-solution.json"
  ],
  "contributes": {
    "commands": [
      { "command": "spfxPretty.scan", "title": "Scan Project", "category": "SPFX-Pretty", "icon": "$(refresh)" },
      { "command": "spfxPretty.showReport", "title": "Show App Catalog Preview & Report", "category": "SPFX-Pretty", "icon": "$(preview)" },
      { "command": "spfxPretty.makeTitlesNice", "title": "Make Titles Nice (App Catalog + Toolbox)", "category": "SPFX-Pretty" },
      { "command": "spfxPretty.generateIcons", "title": "Generate Icons (.sppkg, Web Parts, Teams)", "category": "SPFX-Pretty" },
      { "command": "spfxPretty.fixAll", "title": "Apply All Safe Fixes", "category": "SPFX-Pretty", "icon": "$(sparkle)" },
      { "command": "spfxPretty.uploadCompanyLogo", "title": "Upload Company Logo (App Catalog, Teams, Toolbox)", "category": "SPFX-Pretty", "icon": "$(file-media)" },
      { "command": "spfxPretty.upgradeAssessment", "title": "Version Check & Upgrade Assessment", "category": "SPFX-Pretty", "icon": "$(versions)" },
      { "command": "spfxPretty.themingSnippet", "title": "Show Theme-Aware Web Part Snippet", "category": "SPFX-Pretty" },
      { "command": "spfxPretty.filter", "title": "Filter by Severity...", "category": "SPFX-Pretty", "icon": "$(filter)" },
      { "command": "spfxPretty.filterActive", "title": "Filter by Severity (filtered)...", "category": "SPFX-Pretty", "icon": "$(filter-filled)" },
      { "command": "spfxPretty.filterErrors", "title": "Show Errors Only", "category": "SPFX-Pretty" },
      { "command": "spfxPretty.filterWarnings", "title": "Show Errors and Warnings", "category": "SPFX-Pretty" },
      { "command": "spfxPretty.filterAll", "title": "Show All Findings", "category": "SPFX-Pretty" },
      { "command": "spfxPretty.applyFix", "title": "Apply Fix...", "category": "SPFX-Pretty", "icon": "$(lightbulb)" },
      { "command": "spfxPretty.fixCategory", "title": "Fix All in This Group", "category": "SPFX-Pretty", "icon": "$(sparkle)" },
      { "command": "spfxPretty.ignoreRule", "title": "Ignore This Rule (workspace)", "category": "SPFX-Pretty", "icon": "$(eye-closed)" },
      { "command": "spfxPretty.copyMessage", "title": "Copy Message", "category": "SPFX-Pretty" },
      { "command": "spfxPretty.openFinding", "title": "Open", "category": "SPFX-Pretty" }
    ],
    "menus": {
      "view/title": [
        { "command": "spfxPretty.filter", "when": "view == spfxPretty.findings && !spfxPretty.filtered", "group": "navigation@0" },
        { "command": "spfxPretty.filterActive", "when": "view == spfxPretty.findings && spfxPretty.filtered", "group": "navigation@0" },
        { "command": "spfxPretty.filterErrors", "when": "view == spfxPretty.findings", "group": "1_filter@1" },
        { "command": "spfxPretty.filterWarnings", "when": "view == spfxPretty.findings", "group": "1_filter@2" },
        { "command": "spfxPretty.filterAll", "when": "view == spfxPretty.findings", "group": "1_filter@3" },
        { "command": "spfxPretty.scan", "when": "view == spfxPretty.findings", "group": "navigation@1" },
        { "command": "spfxPretty.showReport", "when": "view == spfxPretty.findings", "group": "navigation@2" },
        { "command": "spfxPretty.fixAll", "when": "view == spfxPretty.findings", "group": "navigation@3" },
        { "command": "spfxPretty.uploadCompanyLogo", "when": "view == spfxPretty.findings", "group": "navigation@4" },
        { "command": "spfxPretty.upgradeAssessment", "when": "view == spfxPretty.findings", "group": "navigation@5" }
      ],
      "view/item/context": [
        { "command": "spfxPretty.applyFix", "when": "view == spfxPretty.findings && viewItem == finding.fixable", "group": "inline" },
        { "command": "spfxPretty.fixCategory", "when": "view == spfxPretty.findings && viewItem == category.fixable", "group": "inline" },
        { "command": "spfxPretty.applyFix", "when": "view == spfxPretty.findings && viewItem == finding.fixable", "group": "1_fix@1" },
        { "command": "spfxPretty.fixCategory", "when": "view == spfxPretty.findings && viewItem == category.fixable", "group": "1_fix@1" },
        { "command": "spfxPretty.openFinding", "when": "view == spfxPretty.findings && viewItem =~ /^finding/", "group": "2_nav@1" },
        { "command": "spfxPretty.copyMessage", "when": "view == spfxPretty.findings && viewItem =~ /^finding/", "group": "2_nav@2" },
        { "command": "spfxPretty.ignoreRule", "when": "view == spfxPretty.findings && viewItem =~ /^finding/", "group": "3_ignore@1" }
      ],
      "commandPalette": [
        { "command": "spfxPretty.applyFix", "when": "false" },
        { "command": "spfxPretty.openFinding", "when": "false" },
        { "command": "spfxPretty.fixCategory", "when": "false" },
        { "command": "spfxPretty.ignoreRule", "when": "false" },
        { "command": "spfxPretty.copyMessage", "when": "false" },
        { "command": "spfxPretty.filterActive", "when": "false" }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        { "id": "spfxPretty", "title": "SPFX-Pretty", "icon": "media/activitybar.svg" }
      ]
    },
    "views": {
      "spfxPretty": [
        { "id": "spfxPretty.findings", "name": "Findings", "icon": "media/activitybar.svg", "contextualTitle": "SPFX-Pretty" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "spfxPretty.findings",
        "contents": "No SharePoint Framework project found yet.\nOpen a folder that contains config/package-solution.json.\n[Scan Project](command:spfxPretty.scan)"
      }
    ],
    "snippets": [
      { "language": "typescript", "path": "./snippets/spfx-theming.code-snippets" },
      { "language": "typescriptreact", "path": "./snippets/spfx-theming.code-snippets" },
      { "language": "scss", "path": "./snippets/spfx-scss.code-snippets" }
    ],
    "configuration": {
      "title": "SPFX-Pretty",
      "properties": {
        "spfxPretty.brandColour": {
          "type": "string",
          "default": "#0F6CBD",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Brand colour used when generating icons (hex, e.g. #0F6CBD)."
        },
        "spfxPretty.companyIcon": {
          "type": "string",
          "default": "",
          "description": "Path to your company logo (PNG). Used for the App Catalog icon, Teams icons and fixes. Set by 'Upload Company Logo'."
        },
        "spfxPretty.brandWords": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Brand spellings to keep in suggested titles, e.g. [\"PlanB\", \"SharePoint\"]. Also learnt from your web part titles and developer name."
        },
        "spfxPretty.checkLatestOnline": {
          "type": "boolean",
          "default": true,
          "description": "Ask the public npm registry for the latest SPFx version (only the package name is sent). Off = use the version table built into the extension."
        },
        "spfxPretty.appNamePrefix": {
          "type": "string",
          "default": "",
          "description": "Optional prefix for every app name so your organisation's apps sort together in the App Catalog and Site Contents (e.g. 'Contoso - ')."
        },
        "spfxPretty.toolboxGroup": {
          "type": "string",
          "default": "",
          "enum": ["", "Text, media, and content", "Discovery", "Communication and collaboration", "Planning and process", "Business and intelligence", "Site tools"],
          "description": "Preferred modern toolbox group for your web parts. Only these predefined groups get a toolbox section - custom groupIds fall back to 'Advanced'."
        },
        "spfxPretty.developer.name": { "type": "string", "default": "", "description": "Developer/company name shown in the App Catalog." },
        "spfxPretty.developer.websiteUrl": { "type": "string", "default": "", "description": "Developer website URL." },
        "spfxPretty.developer.privacyUrl": { "type": "string", "default": "", "description": "Privacy statement URL." },
        "spfxPretty.developer.termsOfUseUrl": { "type": "string", "default": "", "description": "Terms of use URL." },
        "spfxPretty.developer.mpnId": { "type": "string", "default": "Undefined-1.0.0", "description": "Microsoft Partner Network ID (or 'Undefined-x.y.z')." },
        "spfxPretty.disabledRules": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Rule IDs to skip, e.g. [\"BRD003\"]. Can also be set per project in .spfxprettyrc.json."
        },
        "spfxPretty.showReportAfterScan": {
          "type": "boolean",
          "default": true,
          "description": "Open the App Catalog preview & report as soon as you run 'Scan Project'. Off = show a notification with a 'Show report' button instead."
        },
        "spfxPretty.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Re-scan automatically when manifests, package-solution.json or styles are saved."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "icon": "node ./out/tools/makeExtensionIcon.js",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "npm run compile && npm run icon && vsce package --allow-missing-repository",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.2.1",
    "typescript": "5.6.3"
  }
}
